{
  "jupyter-config-data": {
    "appName": "정보·AI 실습 JupyterLite (읽기 전용 · 저장 안 됨)",
    "appUrl": "./lab",
    "appVersion": "0.8.3",
    "baseUrl": "./",
    "contentsAllJsonFile": "all.json",
    "defaultKernelName": "python",
    "faviconUrl": "./lab/favicon.ico",
    "federated_extensions": [
      {
        "extension": "./extension",
        "load": "static/remoteEntry.14ef810bb410daaf.js",
        "name": "@jupyterlite/pyodide-kernel-extension"
      },
      {
        "extension": "./extension",
        "load": "static/remoteEntry.5cbb9d2323598fbda535.js",
        "name": "jupyterlab_pygments",
        "style": "./style"
      }
    ],
    "fullLabextensionsUrl": "./extensions",
    "fullStaticUrl": "./build",
    "licensesUrl": "./lab/api/licenses",
    "litePluginSettings": {
      "@jupyterlite/pyodide-kernel-extension:kernel": {
        "pipliteUrls": [
          "./extensions/@jupyterlite/pyodide-kernel-extension/static/pypi/all.json?sha256=b0fbc8323d9394c8d15587f70bdadd88843643fc9b7cb0595fdc4fbc86af168c"
        ],
        "loadPyodideOptions": {
          "packages": [
            "numpy",
            "pandas",
            "matplotlib",
            "scipy",
            "scikit-learn",
            "seaborn",
            "micropip"
          ]
        }
      }
    },
    "collaborative": false,
    "contentsStorageDrivers": ["memorystorage-memory"],
    "settingsStorageDrivers": ["memorystorage-memory"],
    "workspacesStorageDrivers": ["memorystorage-memory"]
  },
  "jupyter-lite-schema-version": 0
}
